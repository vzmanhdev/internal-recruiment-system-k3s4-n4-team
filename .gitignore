# ==============================================================================
# Git Ignore Configuration - Internal Recruitment System
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Folders excluded per user request (Ngoại trừ theo yêu cầu)
# ------------------------------------------------------------------------------
.agents/
reports/
tmp_test/
.tmp_test/
/tmp/
scratch/
scratch_*.json
/*.png
backend/storage/*

# ------------------------------------------------------------------------------
# 2. Environment Variables & Credentials (Biến môi trường & Bí mật)
# ------------------------------------------------------------------------------

.env.local
.env.*.local
.env.development
.env.test
.env.production


# Cho phép commit file mẫu .env.example
!.env.example
!.env.*.example

# ------------------------------------------------------------------------------
# 3. Python & Backend (FastAPI / SQLAlchemy / Pytest)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend (Next.js / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js Build Output & TypeScript build cache
.next/
.next-e2e/
out/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Databases & SQLite files (Dữ liệu cục bộ)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 6. Logs & Dumps
# ------------------------------------------------------------------------------
*.log
*.dump
*.json_dump
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. OS & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
Assets/database.sql
backend/scripts/
tests/