# =================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Đã được cho phép commit lên Git (Tài liệu hướng dẫn cấu hình)
# =================================================================

# Server & Application Mode
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL / SQLite Fallback)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/recruitment_db
SQLITE_FALLBACK_URL=sqlite:///./sql_app.db

# Security & JWT Authentication (Thay đổi chuỗi bí mật này trên Production)
SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# System Admin Initial Credentials
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=password123

# Email Automation SMTP Configuration (Nếu có)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
