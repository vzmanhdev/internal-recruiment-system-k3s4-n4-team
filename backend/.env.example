PROJECT_NAME="Enterprise Internal Recruitment System API"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL or SQLite)
# SQLite default: sqlite:///./recruitment.db
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/recruitment_db
DATABASE_URL="sqlite:///./recruitment.db"

# JWT Security Secret Key
SECRET_KEY="super-secret-key-change-in-production-1234567890"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================================================
# GMAIL SMTP CONFIGURATION FOR AUTOMATIC OTP & EMAIL NOTIFICATIONS
# ===================================================================
# Để hệ thống tự động gửi email OTP về Gmail thực tế của người dùng:
# 1. Điền địa chỉ Gmail vào SMTP_USERNAME và SMTP_FROM_EMAIL
# 2. Tạo "Mật khẩu ứng dụng" (App Password 16 ký tự) tại Google Account -> Bảo mật -> Mật khẩu ứng dụng
# 3. Dán 16 ký tự mật khẩu ứng dụng vào SMTP_APP_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dtc245200223@ictu.edu.vn
SMTP_APP_PASSWORD=nkdifbmcatnbeomr
SMTP_FROM_EMAIL=dtc245200223@ictu.edu.vn
SMTP_FROM_NAME="Tuyển Dụng Nội Bộ"
SMTP_USE_TLS=true

# Password Reset OTP Expiration & Cooldown
PASSWORD_RESET_OTP_EXPIRE_MINUTES=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
