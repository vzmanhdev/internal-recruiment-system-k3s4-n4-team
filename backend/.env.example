# Backend Service Environment Variables

# PostgreSQL Database Connection URL (Local / Docker)
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/recruitment_db
# Docker PostgreSQL: postgresql://postgres:postgres@db:5432/recruitment_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db

# Security & JWT Token Authentication Configuration
SECRET_KEY=super-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma separated string or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
